{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes.invalid/incremental-ingest/v1/records.json",
  "$defs": {
    "incremental_run": {
      "type": "object",
      "required": [
        "contract",
        "run_id",
        "vault_id",
        "actor",
        "workflow_mode",
        "revision",
        "state",
        "source_workflow_id",
        "source_manifest",
        "policy",
        "contracts",
        "control_ref",
        "budget",
        "reservations",
        "sources",
        "map_result_ids",
        "consumed_map_ids",
        "round_ids",
        "active_round_id",
        "start_fingerprint",
        "last_operation_id"
      ],
      "properties": {
        "contract": {
          "const": "incremental-run/v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "vault_id": {
          "type": "string",
          "minLength": 1
        },
        "source_workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "last_operation_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_mode": {
          "const": "incremental_v1"
        },
        "state": {
          "enum": [
            "active",
            "completed",
            "partial"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {},
        "source_manifest": {
          "type": "array",
          "items": {}
        },
        "policy": {
          "type": "object"
        },
        "contracts": {
          "type": "object"
        },
        "control_ref": {},
        "budget": {
          "type": "object"
        },
        "reservations": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        },
        "map_result_ids": {
          "type": "array",
          "items": {}
        },
        "consumed_map_ids": {
          "type": "array",
          "items": {}
        },
        "round_ids": {
          "type": "array",
          "items": {}
        },
        "active_round_id": {},
        "start_fingerprint": {},
        "closure": {}
      },
      "additionalProperties": false
    },
    "incremental_source_snapshot": {
      "type": "object",
      "required": [
        "contract",
        "snapshot_id",
        "identity",
        "original",
        "unit_set",
        "artifact",
        "bundle",
        "units"
      ],
      "properties": {
        "contract": {
          "const": "incremental-source-snapshot/v1"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object"
        },
        "original": {
          "type": "object"
        },
        "unit_set": {
          "type": "object"
        },
        "artifact": {
          "type": "object"
        },
        "bundle": {},
        "units": {
          "type": "array",
          "items": {}
        }
      },
      "additionalProperties": false
    },
    "incremental_source_seal": {
      "type": "object",
      "required": [
        "contract",
        "seal_id",
