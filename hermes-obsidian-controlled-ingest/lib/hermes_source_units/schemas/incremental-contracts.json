        "request_fingerprint": {},
        "alias_table": {
          "type": "object"
        },
        "results": {
          "type": "array",
          "items": {}
        },
        "coverage": {
          "type": "array",
          "items": {}
        },
        "unresolved": {
          "type": "array",
          "items": {}
        },
        "native_completions": {
          "type": "array",
          "items": {}
        },
        "execution_hold": {
          "type": "object",
          "required": ["ref", "sha256"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "incremental_round_input": {
      "type": "object",
      "required": [
        "contract",
        "run_id",
        "round_id",
        "map_result_ids",
        "context_map_result_ids",
        "context_holds",
        "snapshots",
        "contracts",
        "budget_ids",
        "input_fingerprint"
      ],
      "properties": {
        "contract": {
          "const": "incremental-round-input/v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "map_result_ids": {
          "type": "array",
          "items": {}
        },
        "context_map_result_ids": {
          "type": "array",
          "items": {}
        },
        "context_holds": {
          "type": "array",
