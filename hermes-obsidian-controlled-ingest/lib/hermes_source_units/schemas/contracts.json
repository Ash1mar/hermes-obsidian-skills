          },
          "minItems": 0
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          },
          "minItems": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "run_id",
        "execution_status",
        "inspections",
        "candidates",
        "outputs",
        "reason"
      ],
      "additionalProperties": false
    },
    "provider_extension": {
