          "type": "object"
        },
        "native_completion": {
          "type": "object"
        },
        "sealer_authorization": {
          "type": "object"
        },
        "registry_revision": {},
        "verified": {}
      },
      "additionalProperties": false
    },
    "incremental_map_result": {
      "type": "object",
      "required": [
        "contract",
        "map_result_id",
        "snapshot_id",
        "request_fingerprint",
        "alias_table",
        "results",
        "coverage",
        "unresolved",
        "native_completions",
        "budget_id"
      ],
      "properties": {
        "contract": {
          "const": "incremental-map-result/v1"
        },
        "map_result_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
