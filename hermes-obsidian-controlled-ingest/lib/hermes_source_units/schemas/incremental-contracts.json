        "added_support_refs": {
          "type": "array",
          "items": {}
        },
        "removed_support_refs": {
          "type": "array",
          "items": {}
        },
        "coverage_scope": {
          "type": "object"
        },
        "required_assets": {
          "type": "array",
          "items": {}
        },
        "unresolved": {
          "type": "array",
          "items": {}
        },
        "reason": {},
        "round_fingerprint": {},
        "legacy_untyped": {},
        "native_authorization_ref": {},
        "budget_ref": {}
      },
      "additionalProperties": false
