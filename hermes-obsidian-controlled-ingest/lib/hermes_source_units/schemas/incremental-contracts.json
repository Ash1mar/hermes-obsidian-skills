    "incremental_round_delivery": {
      "type": "object",
      "required": [
        "contract",
        "run_id",
        "round_id",
        "actor",
        "operation_id",
        "authorization",
        "build_run_id",
        "finalize_request",
        "base_release",
        "base_release_sha256",
        "targets",
        "input_fingerprint",
        "delivery_id",
        "owner",
        "registry_revision",
        "revision",
        "state"
      ],
      "properties": {
        "contract": {
          "const": "incremental-round-delivery/v1"
