        "name",
        "page_type",
        "path",
        "expected_parent_revision_id",
        "parent_authored_sha256",
        "input_source_snapshots",
        "mapping_receipts",
        "retained_support_refs",
        "added_support_refs",
        "removed_support_refs",
        "coverage_scope",
        "required_assets",
        "unresolved",
        "reason",
        "round_fingerprint"
      ],
      "properties": {
        "contract": {
          "const": "incremental-page-change/v1"
        },
        "change_id": {
          "type": "string",
          "minLength": 1
