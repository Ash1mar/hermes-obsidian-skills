            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "actor",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "authored_sha256",
        "status",
        "support_refs",
        "review"
      ],
      "additionalProperties": false
    },
    "knowledge_build": {
      "type": "object",
      "properties": {
