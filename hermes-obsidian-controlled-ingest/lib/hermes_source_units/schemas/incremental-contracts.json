    "incremental_control": {
      "type": "object",
      "required": [
        "contract",
        "run_id",
        "actor",
        "revision",
        "state",
        "pause_after",
        "boundary",
        "released",
        "active_scopes"
      ],
      "properties": {
        "contract": {
          "const": "incremental-control/v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "active",
            "pausing",
            "paused",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {},
        "pause_after": {
          "type": "array",
          "items": {}
        },
        "boundary": {},
        "released": {
          "type": "array",
          "items": {}
        },
        "active_scopes": {
          "type": "object"
        },
        "manual_source_admission": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "sha256",
              "state"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "state": {
                "enum": [
                  "held",
                  "released"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "incremental_run_closure": {
      "type": "object",
      "required": [
        "contract",
        "run_id",
        "state",
        "source_outcomes",
        "rounds",
        "coverage_gaps",
        "usage",
        "final_delivery",
        "native_drained"
