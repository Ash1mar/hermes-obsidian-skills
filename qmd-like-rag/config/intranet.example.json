{
  "state_root": "/opt/data/phq/qmd-like-rag-state",
  "include_patterns": [
    "30_Cards/**/*.md",
    "40_Concepts/**/*.md",
    "50_Projects/**/*.md",
    "_system/reports/*.source-map.md",
    "_system/reports/*.spec-index.md",
    "10_Raw/converted/**/document.md"
  ],
  "embedding_backend": "openai_http",
  "embedding_endpoint": "http://models.ai.cnpe.cc/bge-m3/v1/embeddings",
  "embedding_model": "bge-m3",
  "embedding_request_model": null,
  "embedding_batch_size": 32,
  "reranker_backend": "openai_http",
  "reranker_endpoint": "http://models.ai.cnpe.cc/bge/v1/rerank",
  "reranker_model": "bge-reranker-v2-m3",
  "embedding_revision": null,
  "reranker_revision": null,
  "embedding_dimension": 1024,
  "local_files_only": false,
  "require_immutable_model_revisions": false,
  "model_audit_mode": "name-only",
  "model_request_timeout_seconds": 120,
  "model_request_max_retries": 2,
  "device": "cpu",
  "use_reranker": true
}
